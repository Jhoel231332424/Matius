{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Matius Perfect — Modern Bolivian Leather. Machine-readable handoff; runtime CSS values live in styles/variables.css.",
  "color": {
    "$type": "color",
    "ivory": { "$value": "#e6dfcf" },
    "warm-white": { "$value": "#f0eadf" },
    "sand": { "$value": "#c9b9a5" },
    "stone": { "$value": "#9a8875" },
    "charcoal": { "$value": "#17110d" },
    "black": { "$value": "#010101" },
    "cognac": { "$value": "#7d3f23" },
    "tobacco": { "$value": "#5a3521" },
    "dark-brown": { "$value": "#28140a" },
    "red": { "$value": "#9e2c1b" },
    "red-hover": { "$value": "#7f2015" }
  },
  "semantic": {
    "canvas": { "$type": "color", "$value": "{color.warm-white}" },
    "surface": { "$type": "color", "$value": "{color.ivory}" },
    "surface-dark": { "$type": "color", "$value": "{color.charcoal}" },
    "text": { "$type": "color", "$value": "{color.charcoal}" },
    "text-inverse": { "$type": "color", "$value": "{color.warm-white}" },
    "action": { "$type": "color", "$value": "{color.charcoal}" },
    "action-hover": { "$type": "color", "$value": "{color.dark-brown}" },
    "accent": { "$type": "color", "$value": "{color.red}" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Cormorant Garamond", "Georgia", "serif"] },
      "body": { "$value": ["Geist", "Arial", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "24": { "$value": "96px" }
  },
  "size": {
    "container": { "$type": "dimension", "$value": "1280px" },
    "control": { "$type": "dimension", "$value": "48px" },
    "gutter-mobile": { "$type": "dimension", "$value": "20px" },
    "gutter-tablet": { "$type": "dimension", "$value": "32px" },
    "gutter-desktop": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "small": { "$value": "6px" },
    "medium": { "$value": "12px" },
    "large": { "$value": "20px" },
    "full": { "$value": "9999px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "100ms" },
      "fast": { "$value": "160ms" },
      "base": { "$value": "240ms" },
      "slow": { "$value": "520ms" },
      "editorial": { "$value": "760ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "ui": { "$value": [0.2, 0.8, 0.2, 1] },
      "editorial": { "$value": [0.22, 1, 0.36, 1] }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "small": { "$value": "640px" },
    "medium": { "$value": "768px" },
    "large": { "$value": "1024px" },
    "extra-large": { "$value": "1280px" }
  }
}
